{
  "version": 2,
  "builds": [
    {
      "src": "dist/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/app.js"
    },
    {
      "src": "/(browser\\.js|favicon\\.ico|.*\\.css|.*\\.png|.*\\.jpg|.*\\.svg)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/app.js"
    }
  ]
}